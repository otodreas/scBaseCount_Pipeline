#!/bin/sh
set -e

cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
changed=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null) || base=
    [ -n "$base" ] && range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  changed="$changed $(git diff --name-only "$range" -- scripts/cluster_validation/ scripts/h5ad_concat/ tests/pytest/test_h5ad_concat_smoke.py)"
done

case "$changed" in
  *scripts/cluster_validation/*)
    echo "[pre-push] cluster_validation changed; running regression + config snapshot tests"
    RUN_CLVAL_REGRESSION=1 uv run pytest tests/pytest/test_cluster_validation_regression.py -q
    ;;
  *)
    echo "[pre-push] no cluster_validation changes; skipping regression test"
    ;;
esac

case "$changed" in
  *scripts/h5ad_concat/*|*tests/pytest/test_h5ad_concat_smoke.py*)
    echo "[pre-push] h5ad_concat changed; running smoke tests"
    uv run pytest tests/pytest/test_h5ad_concat_smoke.py -q
    ;;
  *)
    echo "[pre-push] no h5ad_concat changes; skipping smoke test"
    ;;
esac
